config SUPPORT_NETCORE_TESTAPP
	bool "Support testapp as Netcore image"

choice NETCORE
	default NETCORE_TESTAPP if SUPPORT_NETCORE_TESTAPP

config NETCORE_TESTAPP
	bool "testapp image"

endchoice

if !NETCORE_NONE

config NETCORE_IMAGE_NAME
	default "testapp_cpunet" if NETCORE_TESTAPP

config NETCORE_IMAGE_PATH
	default "${ZEPHYR_NRF_MODULE_DIR}/tests/benchmarks/bootup_time/testapp" if NETCORE_TESTAPP

endif # !NETCORE_NONE

config SUPPORT_PPRCORE_TESTAPP
	bool "Support testapp as PPR core image"

choice PPRCORE
	default PPRCORE_TESTAPP if SUPPORT_PPRCORE_TESTAPP

config PPRCORE_TESTAPP
	bool "testapp image"

endchoice

if !PPRCORE_NONE

config PPRCORE_IMAGE_NAME
	default "testapp_cpuppr" if PPRCORE_TESTAPP

config PPRCORE_IMAGE_PATH
	default "${ZEPHYR_NRF_MODULE_DIR}/tests/benchmarks/bootup_time/testapp" if PPRCORE_TESTAPP

endif # !PPRCORE_NONE

config SUPPORT_FLPRCORE_TESTAPP
	bool "Support testapp as FLPR core image"

choice FLPRCORE
	default FLPRCORE_TESTAPP if SUPPORT_FLPRCORE_TESTAPP

config FLPRCORE_TESTAPP
	bool "testapp image"

endchoice

if !FLPRCORE_NONE

config FLPRCORE_IMAGE_NAME
	default "testapp_cpuflpr" if FLPRCORE_TESTAPP

config FLPRCORE_IMAGE_PATH
	default "${ZEPHYR_NRF_MODULE_DIR}/tests/benchmarks/bootup_time/testapp" if FLPRCORE_TESTAPP

endif # !FLPRCORE_NONE

source "share/sysbuild/Kconfig"
